# Production Dockerfile for Cloud Run — optimized for minimal image size
FROM node:20-alpine AS base

# Dependencies stage — install only production deps
FROM base AS deps
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma/

# Install prod dependencies only (skip devDependencies)
RUN npm ci --legacy-peer-deps --omit=dev && \
    npx prisma generate && \
    # Remove Prisma engines we don't need (keeps only query engine)
    rm -rf node_modules/@prisma/engines node_modules/prisma && \
    # Clean npm cache inside container
    npm cache clean --force

# Builder stage — build the Next.js app
FROM base AS builder
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Generate Prisma Client
RUN npx prisma generate

# Build Next.js with standalone output
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV SKIP_ENV_VALIDATION=1
RUN npm run build

# Runner stage — minimal production image
FROM node:20-alpine AS runner
RUN apk add --no-cache openssl && \
    rm -rf /var/cache/apk/*
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy ONLY the standalone output (includes necessary node_modules)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Copy Prisma runtime (query engine only)
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

USER nextjs

EXPOSE 3000

# Use exec form for proper signal handling in Cloud Run
CMD ["node", "server.js"]
