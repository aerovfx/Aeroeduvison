# Copy thành .env.onprem và thay JWT_SECRET bằng chuỗi ngẫu nhiên >= 32 ký tự.
AEROEDU_VERSION=local
# connected: build/pull tại máy đích; airgap: dùng image đã docker load.
AEROEDU_INSTALL_MODE=connected
AEROEDU_IMAGE=aeroedu/onprem:local
AEROEDU_PORT=8080
AEROEDU_BIND_ADDRESS=127.0.0.1
PUBLIC_URL=http://localhost:8080
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
POSTGRES_DB=aeroedu
POSTGRES_USER=aeroedu
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_PASSWORD
# Replace with release-approved multi-arch digests. Tags alone are rejected.
NODE_IMAGE=node:22-bookworm-slim@sha256:CHANGE_ME_APPROVED_NODE_DIGEST
POSTGRES_IMAGE=postgres:16-bookworm@sha256:CHANGE_ME_APPROVED_POSTGRES_DIGEST
INSTALLATION_ID=CHANGE_ME_CUSTOMER_SITE_ID
LICENSE_FILE_HOST=./license.json
# Public key is safe to distribute; base64 of license-public.pem for source builds.
LICENSE_PUBLIC_KEY_B64=
LICENSE_ALLOWED_ISSUERS=aeroedu
LICENSE_ISSUER=aeroedu
LICENSE_KEY_ID=primary-2026
LICENSE_REVOKED_IDS=
# Optional base64(JSON): {"aeroedu:key-id":"-----BEGIN PUBLIC KEY-----..."}
LICENSE_TRUSTED_KEYS_JSON_B64=
# CI/bundle should pin the licensed image digest (sha256:...).
AEROEDU_IMAGE_DIGEST=
AEROEDU_IMAGE_ID=
AEROEDU_VERIFIED_RECEIPT=

# true: không gọi dịch vụ cloud chủ động. Tính năng cần Internet sẽ degraded.
OFFLINE_MODE=true
OFFLINE_OUTBOUND_ALLOWLIST=
AI_PROVIDER=demo

# Local AI tùy chọn (Ollama chạy trên LAN/host).
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:latest

# Redis tùy chọn; để trống sẽ dùng fallback trong process.
REDIS_URL=
DISABLE_GATING=false
