# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Redis Configuration
REDIS_URL="redis://:redis_password@redis:6379"
# For local development: REDIS_URL="redis://:redis_password@localhost:6379"
# For production: REDIS_URL="redis://:your-redis-password@your-redis-host:6379"

# Supabase
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
# Production: NEXTAUTH_URL="https://inphysic.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-hex-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-oauth-client-secret"


# Google Cloud Storage Configuration (for file uploads)
GOOGLE_CLOUD_PROJECT_ID="gen-lang-client-0712182643"
GOOGLE_CLOUD_KEY_FILE="path/to/service-account-key.json"
# OR use credentials JSON directly:
GOOGLE_CLOUD_CREDENTIALS='{"type":"service_account",...}'
GCS_BUCKET_NAME="your-gcs-bucket-name"
NEXT_PUBLIC_GCS_BUCKET_NAME="your-gcs-bucket-name"

# Uploadthing (for file uploads)
UPLOADTHING_SECRET="your-uploadthing-secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# Stripe (for payments)
STRIPE_API_KEY="your-stripe-api-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# AI Content Generator
# Choose provider: auto, grok, openrouter, openai, cursor, ollama, demo
AI_PROVIDER="auto"

# Grok API (X.AI) - Fast, powerful, and affordable
# Get API key from: https://console.x.ai
GROK_API_KEY="xai-your-api-key-here"

# OpenRouter - Unified Interface for 500+ AI Models
# Access GPT-5, Claude 4.5, Gemini 2.5 Pro, and more through one API
# Get API key from: https://openrouter.ai
# Recommended: Best balance of features, pricing, and availability
OPENROUTER_API_KEY="sk-or-v1-your-api-key-here"
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# AI Tutor (Gia sư AI) – OpenRouter dùng riêng cho /api/ai-tutor-chat
# Nếu set, AI Tutor sẽ ưu tiên dùng OpenRouter thay vì OpenAI/Grok
AI_TUTOR_OPENROUTER_API_KEY="sk-or-v1-your-api-key-here"
AI_TUTOR_OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"
# Popular models:
# - "anthropic/claude-3.5-sonnet" (default, excellent quality)
# - "openai/gpt-5" (highest quality, premium cost)
# - "google/gemini-2.5-pro" (fast and powerful)
# - "openai/gpt-3.5-turbo" (cheapest, good for chat)
# - "x-ai/grok-2" (Grok via OpenRouter)
# Full list: https://openrouter.ai/models

# OpenAI API (GPT-4 Direct)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-api-key-here"

# Cursor API
CURSOR_API_KEY="your-cursor-api-key"

# Ollama (Local AI - Free & Private)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:latest"

# Google Gemini API (for document analysis and AI features)
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
# Alternative: GOOGLE_AI_API_KEY="your-gemini-api-key-here"
# Model options: gemini-2.5-pro, gemini-2.5-flash, gemini-pro
GEMINI_MODEL="gemini-2.5-flash"

# AI System Configuration (Optional)
AI_CACHE_MAX_SIZE="1000"
AI_CACHE_TTL="86400000"
AI_MAX_CONSECUTIVE_FAILURES="3"
AI_CIRCUIT_BREAKER_TIMEOUT="60000"

# Anthropic Claude API (for AI grading - essay & multiple choice)
# Get API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-api03-your-api-key-here"
# Model options: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-haiku-4-5-20251001
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Rust Grading Service (Port 8100)
RUST_GRADING_URL="http://127.0.0.1:8100"
# Set to "true" to bypass middleware canary and proxy directly to Rust
DIRECT_RUST_GRADING_PROXY="false"
# Canary rollout percentage (0-100): gradual migration from Node.js to Rust
RUST_CANARY_GRADING_PERCENT="0"
