generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model AIGeneratedContent {
  id                String   @id
  userId            String
  type              String
  title             String
  content           String
  subject           String
  grade             String
  topic             String
  curriculum        String?
  difficulty        String   @default("medium")
  estimatedDuration Int      @default(45)
  status            String   @default("draft")
  usageCount        Int      @default(0)
  rating            Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([createdAt])
  @@index([grade])
  @@index([status])
  @@index([subject])
  @@index([type])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Attachment {
  id        String   @id
  name      String
  url       String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Category {
  id     String   @id
  name   String   @unique
  Course Course[]
}

model Chapter {
  id           String         @id
  title        String
  description  String?
  videoUrl     String?
  position     Int
  isPublished  Boolean        @default(false)
  isFree       Boolean        @default(false)
  courseId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  Course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  MuxData      MuxData?
  UserProgress UserProgress[]

  @@index([courseId])
}

model ChatMessage {
  id                String        @id
  roomId            String
  senderId          String
  content           String
  type              String        @default("text")
  replyToId         String?
  isDeleted         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  ChatMessage       ChatMessage?  @relation("ChatMessageToChatMessage", fields: [replyToId], references: [id])
  other_ChatMessage ChatMessage[] @relation("ChatMessageToChatMessage")
  ChatRoom          ChatRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  User              User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model ChatParticipant {
  id       String    @id
  roomId   String
  userId   String
  role     String    @default("participant")
  isActive Boolean   @default(true)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  ChatRoom ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  User     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model ChatRoom {
  id              String            @id
  name            String
  description     String?
  type            String            @default("1-1")
  status          String            @default("active")
  maxParticipants Int               @default(2)
  schoolId        String?
  createdBy       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  ChatMessage     ChatMessage[]
  ChatParticipant ChatParticipant[]
  DebateTopic     DebateTopic?
}

model Course {
  id          String       @id
  userId      String
  schoolId    String       @default("default-school")
  title       String
  description String?
  imageUrl    String?
  price       Float?
  isPublished Boolean      @default(false)
  categoryId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  Attachment  Attachment[]
  Chapter     Chapter[]
  Category    Category?    @relation(fields: [categoryId], references: [id])
  User        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  Purchase    Purchase[]

  @@index([categoryId])
  @@index([schoolId])
}

model DebateResult {
  id            String      @id
  topicId       String
  participantId String
  totalScore    Float
  averageScore  Float
  voteCount     Int
  rank          Int
  createdAt     DateTime    @default(now())
  DebateTopic   DebateTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model DebateTopic {
  id              String         @id
  title           String
  description     String?
  category        String?
  difficulty      String         @default("medium")
  timeLimit       Int            @default(300)
  maxParticipants Int            @default(2)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  DebateResult    DebateResult[]
  ChatRoom        ChatRoom       @relation(fields: [id], references: [id])
  DebateVote      DebateVote[]
}

model DebateVote {
  id            String      @id
  topicId       String
  voterId       String
  participantId String
  score         Int
  comment       String?
  createdAt     DateTime    @default(now())
  DebateTopic   DebateTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  User          User        @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([topicId, voterId, participantId])
}

model MuxData {
  id         String  @id
  assetId    String
  playbackId String?
  chapterId  String  @unique
  Chapter    Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model Purchase {
  id        String   @id
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model ResetToken {
  id        String   @id
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  @@index([email])
  @@index([token])
}

model STEMDeliverable {
  id            String        @id
  title         String
  description   String?
  type          String
  url           String?
  milestoneId   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  STEMMilestone STEMMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model STEMFeedback {
  id          String      @id
  author      String
  content     String
  type        String
  isResolved  Boolean     @default(false)
  projectId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  STEMProject STEMProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model STEMMilestone {
  id              String            @id
  title           String
  description     String?
  status          String
  dueDate         DateTime?
  completedAt     DateTime?
  projectId       String
  position        Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  STEMDeliverable STEMDeliverable[]
  STEMProject     STEMProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model STEMProject {
  id             String           @id
  title          String
  description    String?
  category       String
  status         String
  difficulty     String
  progress       Int              @default(0)
  isPublic       Boolean          @default(false)
  thumbnail      String?
  dueDate        DateTime?
  userId         String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  STEMFeedback   STEMFeedback[]
  STEMMilestone  STEMMilestone[]
  User           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  STEMTeamMember STEMTeamMember[]

  @@index([category])
  @@index([status])
  @@index([userId])
}

model STEMTeamMember {
  id          String      @id
  name        String
  role        String
  email       String
  avatar      String?
  projectId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  STEMProject STEMProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StripeCustomer {
  id               String   @id
  userId           String   @unique
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime
}

// ─── Subscription & AI Access Control ───────────────────────────────
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String    @default("FREE") // FREE | TEACHER_PRO | STUDENT_PRO | SCHOOL
  status               String    @default("active") // active | canceled | past_due | trialing
  gateway              String    @default("sepay") // sepay | stripe
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  billingCycle         String?   // monthly | yearly
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments             Payment[]

  @@index([userId])
  @@index([stripeSubscriptionId])
  @@index([status])
}

model Payment {
  id              String    @id @default(cuid())
  orderId         String    @unique  // SUB-PLAN-USERID-TIMESTAMP
  userId          String
  subscriptionId  String?
  gateway         String    @default("sepay") // sepay | stripe
  method          String?   // BANK_TRANSFER | CREDIT_CARD | E_WALLET
  amount          Int       // VND (integer, no decimals)
  currency        String    @default("VND")
  status          String    @default("pending") // pending | completed | failed | canceled | refunded
  plan            String    // STUDENT_PRO | TEACHER_PRO | SCHOOL
  billingCycle    String    // monthly | yearly
  gatewayRef      String?   // SePay transaction reference / Stripe payment intent
  gatewayData     Json?     // Raw response from gateway (IPN payload)
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model AiUsageLog {
  id        String   @id @default(cuid())
  userId    String
  feature   String   // ai_chat | ai_question_bank | ai_content_validation | ai_vision
  action    String   // e.g. "chat_message", "generate_question", "validate_content"
  count     Int      @default(1)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, feature, createdAt])
  @@index([createdAt])
}

model User {
  id                       String                     @id @default(cuid())
  name                     String?
  email                    String                     @unique
  emailVerified            DateTime?
  image                    String?
  updatedAt                DateTime                   @updatedAt
  role                     String                     @default("STUDENT")
  schoolId                 String                     @default("default-school")
  xp                       Int                        @default(0)
  failedLoginAttempts      Int                        @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  lastLoginIp              String?
  twoFactorEnabled         Boolean                    @default(false)
  twoFactorSecret          String?
  twoFactorBackupCodes     String[]                   @default([])
  createdAt                DateTime                   @default(now())
  password                 String?
  dateOfBirth              DateTime?
  gender                   String?
  idNumber                 String?
  Account                  Account[]
  AuthLog                  AuthLog[]
  ChatMessage              ChatMessage[]
  ChatParticipant          ChatParticipant[]
  Classes                  Class[]                    @relation("ClassTeacher")
  ClassStudents            ClassStudent[]             @relation("ClassStudent")
  Course                   Course[]
  DebateVote               DebateVote[]
  Document                 Document[]
  DocumentFolder           DocumentFolder[]
  LatexProject             LatexProject[]
  LatexProjectCollaborator LatexProjectCollaborator[]
  Exam                     Exam[]
  ExamMatrix               ExamMatrix[]
  EmotionCapture           EmotionCapture[]
  LabCompletion            LabCompletion[]
  STEMProject              STEMProject[]
  Session                  Session[]
  ExamRoomTeacher          OnlineExamRoom[]           @relation(name: "ExamRoomTeacher")
  ExamRoomParticipant      ExamRoomParticipant[]      @relation(name: "ExamRoomParticipants")
  DigitizedResource        DigitizedResource[]
  UserAgentSettings        UserAgentSettings?
  Subscription             Subscription?
  AiUsageLog               AiUsageLog[]
  Payment                  Payment[]
  SurveyResponse           SurveyResponse[]           @relation("StudentSurveys")
  StudentLearningPaths     LearningPath[]             @relation("StudentLearningPaths")
  TeacherApprovals         LearningPathApproval[]     @relation("TeacherApprovals")
  CreatedTemplates         LearningPathTemplate[]     @relation("TemplateCreator")

  @@index([schoolId])
  @@index([email])
}

// Cài đặt agents theo vai trò (student/teacher/admin) - lưu theo userId
model UserAgentSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  role      String   // STUDENT | TEACHER | ADMIN
  settings  Json     // { "ai-tutor": {...}, "study-planner": {...}, ... }
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([role])
}

// Biểu cảm gộp theo cửa sổ thời gian (1 phút) để giảm tải: không lưu từng frame
model EmotionCapture {
  id            String   @id @default(cuid())
  userId        String
  windowStart   DateTime // Đầu cửa sổ (làm tròn theo phút)
  sampleCount   Int      @default(0)
  avgConfidence Float    @default(0)
  emotionCounts Json // { "happy": 5, "neutral": 10 } - số lần mỗi biểu cảm trong cửa sổ
  sessionId     String? // Optional: phiên học / lớp
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, windowStart])
  @@index([userId])
  @@index([windowStart])
  @@index([userId, windowStart])
}

model UserProgress {
  id          String   @id
  userId      String
  chapterId   String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([chapterId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuthLog {
  id        String   @id
  userId    String?
  email     String
  action    String
  status    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
}

model LabCompletion {
  id          String   @id @default(cuid())
  userId      String
  labId       String
  labName     String
  xpEarned    Int
  parameters  Json?
  completedAt DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, labId])
  @@index([userId])
  @@index([labId])
  @@index([completedAt])
}

model DocumentFolder {
  id                 String              @id @default(cuid())
  name               String
  parentId           String?
  userId             String
  path               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  documents          Document[]
  latexProjects      LatexProject[]
  digitizedResources DigitizedResource[]
  parent             DocumentFolder?     @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children           DocumentFolder[]    @relation("FolderHierarchy")
  User               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentId])
  @@index([path])
}

model Document {
  id              String                  @id @default(cuid())
  name            String
  displayName     String
  type            String
  mimeType        String?
  fileSize        Int?
  originalUrl     String
  digitizedUrl    String?
  folderId        String?
  userId          String
  status          String                  @default("Hàng đợi")
  processingError String?
  executionTime   Int?
  ocrText         String?
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  processedAt     DateTime?
  folder          DocumentFolder?         @relation(fields: [folderId], references: [id])
  User            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  processingLogs  DocumentProcessingLog[]

  @@index([userId])
  @@index([folderId])
  @@index([status])
  @@index([createdAt])
  @@index([type])
}

model DocumentProcessingLog {
  id         String   @id @default(cuid())
  documentId String
  stage      String
  message    String?
  metadata   Json?
  createdAt  DateTime @default(now())
  Document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([createdAt])
  @@index([stage])
}

model LatexProject {
  id            String                     @id @default(cuid())
  userId        String
  title         String
  mainContent   String                     @default("")
  folderId      String?
  extraFiles    Json? // map filename -> content for multi-file later
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  User          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder        DocumentFolder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions      LatexProjectVersion[]
  collaborators LatexProjectCollaborator[]

  @@index([userId])
  @@index([folderId])
  @@index([createdAt])
}

model LatexProjectVersion {
  id            String       @id @default(cuid())
  projectId     String
  mainContent   String
  titleSnapshot String?
  trigger       String       @default("save") // "save" | "compile"
  createdAt     DateTime     @default(now())
  LatexProject  LatexProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model LatexProjectCollaborator {
  id           String       @id @default(cuid())
  projectId    String
  userId       String
  role         String       @default("VIEW") // "VIEW" | "EDIT"
  createdAt    DateTime     @default(now())
  LatexProject LatexProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ExamMatrix {
  id                String                   @id @default(cuid())
  name              String
  subject           String?
  grade             String
  examType          String
  duration          Int
  totalScore        Float
  totalQuestions    Int                      @default(0)
  type              String                   @default("Tạo mới")
  status            String                   @default("Hàng đợi")
  originalFileUrl   String?
  digitizedFileUrl  String?
  processingError   String?
  userId            String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  processedAt       DateTime?
  User              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  processingLogs    MatrixProcessingLog[]
  topics            MatrixTopic[]
  selectedQuestions MatrixSelectedQuestion[]
  onlineExamRooms   OnlineExamRoom[]

  @@index([userId])
  @@index([status])
  @@index([grade])
  @@index([examType])
  @@index([createdAt])
}

model MatrixSelectedQuestion {
  id         String     @id @default(cuid())
  matrixId   String
  questionId String
  createdAt  DateTime   @default(now())
  ExamMatrix ExamMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  Question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([matrixId, questionId])
  @@index([matrixId])
  @@index([questionId])
}

model MatrixTopic {
  id              String                 @id @default(cuid())
  matrixId        String
  order           Int
  topic           String
  content         String?
  percentageScore Float?
  ExamMatrix      ExamMatrix             @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  distributions   QuestionDistribution[]

  @@index([matrixId])
  @@index([order])
}

model QuestionDistribution {
  id             String      @id @default(cuid())
  topicId        String
  questionType   String
  cognitiveLevel String
  count          Int         @default(0)
  MatrixTopic    MatrixTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, questionType, cognitiveLevel])
  @@index([topicId])
}

model MatrixProcessingLog {
  id         String     @id @default(cuid())
  matrixId   String
  stage      String
  message    String?
  metadata   Json?
  createdAt  DateTime   @default(now())
  ExamMatrix ExamMatrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@index([matrixId])
  @@index([createdAt])
  @@index([stage])
}

model Exam {
  id             String         @id @default(cuid())
  title          String
  description    String?
  examType       String
  duration       Int // phút
  totalScore     Float
  totalQuestions Int            @default(0)
  status         String         @default("Nháp")
  matrixId       String?
  userId         String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  User           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  examQuestions  ExamQuestion[]
  roomSchedules  ExamRoomSchedule[]

  @@index([userId])
  @@index([matrixId])
  @@index([status])
  @@index([createdAt])
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  questionId String
  order      Int      @default(0)
  points     Float    @default(0)
  Exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  Question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
}

model Class {
  id          String         @id @default(cuid())
  name        String
  grade       String
  schoolYear  String
  description String?
  teacherId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  teacher     User           @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  students    ClassStudent[]

  @@index([teacherId])
  @@index([grade])
  @@index([schoolYear])
  @@index([createdAt])
}

model ClassStudent {
  id             String   @id @default(cuid())
  classId        String
  studentId      String
  studentNumber  Int?
  enrollmentDate DateTime @default(now())
  status         String   @default("active")
  attendanceRate Float?
  averageScore   Float?
  totalXP        Int      @default(0)
  completedExams Int      @default(0)
  passedExams    Int      @default(0)
  notes          String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student        User     @relation("ClassStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
  @@index([status])
}

model Question {
  id                  String                   @id @default(cuid())
  topic               String
  subject             String
  grade               String
  questionType        String
  difficulty          String
  content             String
  options             String[]
  correctAnswer       String?
  explanation         String
  learningObjectives  String[]
  keywords            String[]
  qualityScore        Float?
  discriminationIndex Float?
  usageCount          Int                      @default(0)
  averageScore        Float?
  averageTimeSeconds  Int?
  aiGenerated         Boolean                  @default(false)
  aiModel             String?
  humanReviewed       Boolean                  @default(false)
  reviewedBy          String?
  reviewedAt          DateTime?
  status              String                   @default("Nháp")
  createdBy           String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  tags                String[]
  metadata            Json?
  imageUrl            String?
  matrixSelections    MatrixSelectedQuestion[]
  examQuestions       ExamQuestion[]
  examRoomQuestions   ExamRoomQuestion[]

  @@index([subject])
  @@index([grade])
  @@index([questionType])
  @@index([difficulty])
  @@index([status])
  @@index([createdBy])
  @@index([humanReviewed])
  @@index([aiGenerated])
  @@index([createdAt])
  @@index([qualityScore])
  @@index([usageCount])
}

// Fine-tune: bài đào tạo mặc định + lịch sử + phát hiện trùng
model FineTuneLesson {
  id           String            @id @default(cuid())
  name         String
  description  String?
  systemPrompt String?           @map("system_prompt")
  isDefault    Boolean           @default(false) @map("is_default")
  createdById  String?           @map("created_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  examples     FineTuneExample[]
  runs         FineTuneRun[]

  @@index([isDefault])
  @@index([createdById])
}

model FineTuneExample {
  id                String         @id @default(cuid())
  lessonId          String         @map("lesson_id")
  userPrompt        String         @map("user_prompt")
  assistantResponse String         @map("assistant_response")
  createdAt         DateTime       @default(now()) @map("created_at")
  lesson            FineTuneLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model FineTuneRun {
  id            String          @id @default(cuid())
  modelName     String          @map("model_name")
  lessonId      String?         @map("lesson_id")
  lesson        FineTuneLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  status        String          @default("completed")
  examplesCount Int             @default(0) @map("examples_count")
  startedAt     DateTime        @default(now()) @map("started_at")
  completedAt   DateTime?       @map("completed_at")
  createdById   String?         @map("created_by_id")

  @@index([modelName])
  @@index([lessonId])
  @@index([startedAt])
}

model OnlineExamRoom {
  id           String                @id @default(cuid())
  name         String
  description  String?
  teacherId    String
  examMatrixId String?
  startTime    DateTime
  endTime      DateTime
  duration     Int                   @default(45) // minutes
  status       String                @default("draft") // draft, active, completed, cancelled
  isPublic     Boolean               @default(false)
  accessCode   String?               @unique // 6-digit code for students to join
  maxStudents  Int?
  instructions String?               @db.Text
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  Teacher      User                  @relation(fields: [teacherId], references: [id], onDelete: Cascade, name: "ExamRoomTeacher")
  ExamMatrix   ExamMatrix?           @relation(fields: [examMatrixId], references: [id], onDelete: SetNull)
  participants ExamRoomParticipant[]
  questions    ExamRoomQuestion[]
  schedules    ExamRoomSchedule[]

  @@index([teacherId])
  @@index([status])
  @@index([startTime])
  @@index([accessCode])
}

model ExamRoomSchedule {
  id         String         @id @default(cuid())
  examRoomId String
  examId     String
  label      String?
  activeFrom DateTime
  activeTo   DateTime
  isActive   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  ExamRoom   OnlineExamRoom @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  Exam       Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examRoomId])
  @@index([examId])
  @@index([activeFrom])
  @@index([activeTo])
}

model ExamRoomParticipant {
  id          String           @id @default(cuid())
  examRoomId  String
  studentId   String
  joinedAt    DateTime         @default(now())
  submittedAt DateTime?
  status      String           @default("joined") // joined, taking, submitted, absent
  score       Float?
  answers     ExamRoomAnswer[]
  ExamRoom    OnlineExamRoom   @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  Student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade, name: "ExamRoomParticipants")

  @@unique([examRoomId, studentId])
  @@index([examRoomId])
  @@index([studentId])
  @@index([status])
}

model ExamRoomQuestion {
  id           String           @id @default(cuid())
  examRoomId   String
  questionId   String
  position     Int
  points       Float            @default(1.0)
  questionType String
  ExamRoom     OnlineExamRoom   @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  Question     Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers      ExamRoomAnswer[]

  @@unique([examRoomId, questionId])
  @@index([examRoomId])
  @@index([questionId])
}

model ExamRoomAnswer {
  id            String              @id @default(cuid())
  participantId String
  questionId    String
  answer        String              @db.Text
  isCorrect     Boolean?
  pointsEarned  Float?
  submittedAt   DateTime            @default(now())
  Participant   ExamRoomParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  Question      ExamRoomQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionId])
  @@index([participantId])
  @@index([questionId])
}

// ============================================
// Digitization Models for Educational Materials
// ============================================

// Main model for all digitized resources (unified)
model DigitizedResource {
  id               String    @id @default(cuid())
  title            String
  description      String?   @db.Text
  resourceType     String // TEXTBOOK, EXAM_PAPER, AUDIO, VIDEO, DOCUMENT, IMAGE
  subject          String?
  grade            String?
  language         String    @default("vi")
  originalFileUrl  String
  digitizedFileUrl String?
  thumbnailUrl     String?
  fileSize         Int? // bytes
  mimeType         String?
  duration         Int? // seconds for audio/video
  pageCount        Int? // for books/documents
  ocrText          String?   @db.Text
  metadata         Json? // flexible metadata
  status           String    @default("pending") // pending, processing, completed, failed
  processingError  String?
  quality          String? // LOW, MEDIUM, HIGH
  isPublic         Boolean   @default(false)
  downloadCount    Int       @default(0)
  viewCount        Int       @default(0)
  userId           String
  folderId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  processedAt      DateTime?

  User           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  DocumentFolder DocumentFolder?             @relation(fields: [folderId], references: [id], onDelete: SetNull)
  Textbook       Textbook?
  ExamPaper      ExamPaper?
  AudioResource  AudioResource?
  VideoResource  VideoResource?
  ResourceTag    ResourceTag[]
  ProcessingLog  DigitizationProcessingLog[]

  @@index([userId])
  @@index([folderId])
  @@index([resourceType])
  @@index([subject])
  @@index([grade])
  @@index([status])
  @@index([createdAt])
  @@index([isPublic])
}

// Textbook-specific metadata
model Textbook {
  id              String   @id @default(cuid())
  resourceId      String   @unique
  title           String
  authors         String[] // list of author names
  publisher       String?
  edition         String?
  isbn            String?
  publicationYear Int?
  curriculum      String? // e.g., "VN-GDPT-2018"
  chapters        Json? // chapter structure: [{title, pageCount, startPage}]
  tableOfContents String?  @db.Text
  subject         String
  grade           String
  language        String   @default("vi")
  isDigitalNative Boolean  @default(false) // true if born-digital, false if scanned
  scanQuality     String? // DPI or quality metric
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  DigitizedResource DigitizedResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([subject])
  @@index([grade])
  @@index([isbn])
}

// Exam paper / test specific metadata
model ExamPaper {
  id                 String   @id @default(cuid())
  resourceId         String   @unique
  title              String
  examType           String // MIDTERM, FINAL, QUIZ, PRACTICE, ENTRANCE, GRADUATION
  subject            String
  grade              String
  schoolYear         String // e.g., "2024-2025"
  semester           Int? // 1 or 2
  duration           Int? // minutes
  totalScore         Float?
  questionCount      Int?
  isOfficial         Boolean  @default(false)
  source             String? // school, department, ministry
  academicYear       String?
  region             String? // province/city
  schoolName         String?
  extractedQuestions Json? // structured questions from OCR
  answerKey          String?  @db.Text
  solutions          String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  DigitizedResource DigitizedResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([examType])
  @@index([subject])
  @@index([grade])
  @@index([schoolYear])
  @@index([isOfficial])
}

// Audio resource metadata (lectures, listening tests, podcasts)
model AudioResource {
  id           String   @id @default(cuid())
  resourceId   String   @unique
  title        String
  audioType    String // LECTURE, LISTENING_TEST, PODCAST, PRONUNCIATION, MUSIC
  subject      String?
  grade        String?
  language     String   @default("vi")
  speaker      String? // narrator/teacher name
  duration     Int // seconds
  format       String? // MP3, WAV, AAC, etc.
  bitrate      Int? // kbps
  sampleRate   Int? // Hz
  channels     Int? // 1=mono, 2=stereo
  transcript   String?  @db.Text
  hasSubtitles Boolean  @default(false)
  chapters     Json? // [{title, startTime, endTime}]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  DigitizedResource DigitizedResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([audioType])
  @@index([subject])
  @@index([language])
}

// Video resource metadata (lectures, tutorials, demonstrations)
model VideoResource {
  id                String   @id @default(cuid())
  resourceId        String   @unique
  title             String
  videoType         String // LECTURE, TUTORIAL, DEMO, ANIMATION, DOCUMENTARY, LAB
  subject           String?
  grade             String?
  language          String   @default("vi")
  presenter         String? // teacher/presenter name
  duration          Int // seconds
  format            String? // MP4, WEBM, MOV, etc.
  resolution        String? // 720p, 1080p, 4K
  fps               Int? // frames per second
  hasAudio          Boolean  @default(true)
  hasSubtitles      Boolean  @default(false)
  subtitleLanguages String[] // list of language codes
  transcript        String?  @db.Text
  chapters          Json? // [{title, startTime, endTime}]
  thumbnailUrl      String?
  previewUrl        String? // short preview clip
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  DigitizedResource DigitizedResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([videoType])
  @@index([subject])
  @@index([language])
}

// Flexible tagging system for resources
model ResourceTag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String? // hex color for UI
  category    String? // subject, topic, skill, etc.
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resources DigitizedResource[]

  @@index([category])
  @@index([usageCount])
}

// Processing logs for digitization workflow
model DigitizationProcessingLog {
  id         String   @id @default(cuid())
  resourceId String
  stage      String // UPLOAD, OCR, PROCESSING, QUALITY_CHECK, PUBLISHING
  action     String // started, completed, failed, retry
  message    String?  @db.Text
  metadata   Json? // technical details
  duration   Int? // milliseconds
  createdAt  DateTime @default(now())

  DigitizedResource DigitizedResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([stage])
  @@index([createdAt])
}

// ============================================
// Agent System Tables
// ============================================

// Agent sessions for tracking conversations
model AgentSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  agentId   String
  userId    String
  state     String   @default("idle") // idle, running, paused, stopped, error
  messages  Json     @default("[]") // Array of messages
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([agentId])
  @@index([sessionId])
  @@index([createdAt])
}

// Agent usage tracking
model AgentUsage {
  id           String   @id @default(cuid())
  agentId      String
  userId       String
  action       String
  tokensUsed   Int      @default(0)
  cost         Float    @default(0)
  responseTime Int      // milliseconds
  success      Boolean  @default(true)
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([agentId])
  @@index([createdAt])
  @@index([action])
}

// Practice exams for students
model PracticeExam {
  id            String   @id @default(cuid())
  studentId     String
  subject       String
  grade         String
  examType      String
  questionCount Int      @default(30)
  timeLimit     Int      @default(45) // minutes
  questions     Json     @default("[]") // Array of question objects
  answers       Json     @default("[]") // Array of user answers
  score         Float?
  percentage    Float?
  breakdown     Json?    // { correct, incorrect, byTopic }
  recommendations Json?  @default("[]")
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([studentId])
  @@index([subject])
  @@index([grade])
  @@index([completed])
  @@index([createdAt])
}

// Career recommendations for students
model CareerRecommendation {
  id             String   @id @default(cuid())
  studentId      String
  career         String
  matchScore     Float
  reasons        Json     @default("[]")
  universities   Json     @default("[]")
  salaryRange    String?
  demandLevel    String   // high, medium, low
  actionPlan     Json     @default("[]")
  createdAt      DateTime @default(now())

  @@index([studentId])
  @@index([career])
  @@index([matchScore])
  @@index([createdAt])
}

// Personality test results history
model PersonalityTestResult {
  id             String   @id @default(cuid())
  studentId      String
  mbtiType       String   // e.g. "INTJ"
  mbtiScores     Json     // { E: 41, I: 59, S: 57, N: 43, T: 62, F: 38, J: 45, P: 55 }
  hollandCode    String   // e.g. "RIA"
  hollandScores  Json     // { R: 85, I: 72, A: 60, S: 45, E: 30, C: 20 }
  personalityName String  // e.g. "Nhà Chiến Lược"
  careers        Json     @default("[]") // recommended careers
  answers        Json     @default("{}") // raw answers for re-analysis
  createdAt      DateTime @default(now())

  @@index([studentId])
  @@index([mbtiType])
  @@index([createdAt])
}

// Lesson plans for teachers
model LessonPlan {
  id          String   @id @default(cuid())
  teacherId   String
  subject     String
  grade       String
  topic       String
  duration    Int      @default(45)
  content     Json     // Full lesson plan content
  slides      Json?    // Slide data if generated
  quiz        Json?    // Quiz questions if generated
  status      String   @default("draft") // draft, published, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teacherId])
  @@index([subject])
  @@index([grade])
  @@index([status])
}

// Daily reminders for students
model DailyReminder {
  id        String   @id @default(cuid())
  studentId String
  type      String   // study, exam, career
  message   String
  sent      Boolean  @default(false)
  sentAt    DateTime?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([type])
  @@index([sent])
  @@index([createdAt])
}

// Weekly/Monthly reports
model AgentReport {
  id        String   @id @default(cuid())
  type      String   // daily, weekly, monthly
  userId    String?
  agentId   String?
  metrics   Json     @default("{}")
  summary   String?
  period    String   // e.g., "2026-W12" or "2026-03"
  createdAt DateTime @default(now())

  @@index([type])
  @@index([userId])
  @@index([period])
  @@index([createdAt])
}

// Rate limiting
model RateLimit {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  count     Int      @default(0)
  window    DateTime // Window start time
  resetAt   DateTime // When the limit resets

  @@unique([userId, endpoint, window])
  @@index([userId])
  @@index([endpoint])
  @@index([resetAt])
}

// Camera Recording Management
model CameraRecording {
  id          String   @id @default(cuid())
  cameraId    String
  cameraName  String
  teacherId   String?  // null for admin recordings
  classId     String?  // associated class if classroom camera
  startTime   DateTime @default(now())
  endTime     DateTime?
  duration    Int?     // seconds
  videoUrl    String   // path to recorded video file
  thumbnailUrl String? // path to thumbnail image
  fileSize    Int?     // bytes
  status      String   @default("recording") // recording, completed, failed, processing
  metadata    Json?    // additional info (resolution, fps, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cameraId])
  @@index([teacherId])
  @@index([classId])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
}

// ===================== GRADING: Answer Keys & Graded Sheets =====================

model GradingAnswerKey {
  id             String   @id @default(cuid())
  teacherId      String
  examName       String   @default("")
  examCode       String   @default("")
  examDate       String   @default("")
  studentName    String   @default("") // Template student info
  studentId      String   @default("") // Số báo danh mẫu
  examSite       String   @default("") // Hội đồng thi
  examRoom       String   @default("") // Phòng thi số
  dob            String   @default("") // Ngày sinh
  part1          Json     // Record<number, 'A'|'B'|'C'|'D'|null> — 40 câu trắc nghiệm
  part2          Json     // Record<number, Record<string, boolean|null>> — 8 câu đúng/sai
  part3          Json     // Record<number, string> — 6 câu trả lời ngắn
  essayQuestions Json     @default("[]") // EssayQuestion[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  gradedSheets   GradedSheet[]

  @@index([teacherId])
  @@index([examCode])
  @@index([createdAt])
}

model GradedSheet {
  id              String   @id @default(cuid())
  answerKeyId     String
  teacherId       String
  studentName     String   @default("")
  studentId       String   @default("") // Số báo danh
  frontImageUrl   String?  // Mặt trước (trắc nghiệm)
  backImageUrl    String?  // Mặt sau (tự luận)
  detectedAnswers Json     // Record<number, 'A'|'B'|'C'|'D'|null>
  detectedPart2   Json     // Record<number, Record<string, boolean|null>>
  detectedPart3   Json     // Record<number, string>
  essayScores     Json     @default("{}") // Record<string, number>
  essayNotes      Json     @default("{}") // Record<string, string>
  overrides       Json     @default("[]") // number[] — overridden question numbers
  totalScore      Float    @default(0)
  maxScore        Float    @default(10)
  percentage      Float    @default(0)
  gradeLabel      String   @default("") // A, B, C, D, F
  reviewed        Boolean  @default(false)
  published       Boolean  @default(false)
  status          String   @default("scanned") // scanning, scanned, error
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  answerKey       GradingAnswerKey @relation(fields: [answerKeyId], references: [id], onDelete: Cascade)

  @@index([answerKeyId])
  @@index([teacherId])
  @@index([studentId])
  @@index([published])
  @@index([createdAt])
}

// ===== LEARNING PATH SYSTEM =====

// Kết quả khảo sát của học sinh
model SurveyResponse {
  id              String   @id @default(cuid())
  studentId       String
  surveyData      Json     // StudentProfileSurvey data
  assessmentScore Json?    // CompositeAssessment result
  status          String   @default("completed") // completed | processing | error
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student       User           @relation("StudentSurveys", fields: [studentId], references: [id], onDelete: Cascade)
  learningPaths LearningPath[]

  @@index([studentId])
  @@index([createdAt])
}

// Learning path được sinh ra cho từng học sinh (từ AI hoặc từ template)
model LearningPath {
  id               String   @id @default(cuid())
  studentId        String
  title            String
  description      String?
  surveyResponseId String?
  templateId       String?  // null = AI-generated, có giá trị = clone từ template

  // Nội dung learning path (JSON vì linh hoạt cấu trúc)
  goals            Json     @default("[]")  // string[] - mục tiêu
  domains          Json     @default("[]")  // SubjectDomain[]
  segments         Json     @default("[]")  // LearningPathSegment[]
  weeklyPlan       Json     @default("[]")  // week plan
  metadata         Json     @default("{}")  // thông tin thêm

  // Trạng thái tổng thể
  status           String   @default("pending_review")
  // pending_review | in_review | approved | rejected | needs_revision | active | completed | archived

  progress         Float    @default(0)  // 0-100
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student          User                    @relation("StudentLearningPaths", fields: [studentId], references: [id], onDelete: Cascade)
  surveyResponse   SurveyResponse?         @relation(fields: [surveyResponseId], references: [id])
  template         LearningPathTemplate?   @relation(fields: [templateId], references: [id])
  approvalSteps    LearningPathApproval[]

  @@index([studentId])
  @@index([status])
  @@index([templateId])
  @@index([surveyResponseId])
}

// Từng bước duyệt của giáo viên (duyệt từng phần)
model LearningPathApproval {
  id             String   @id @default(cuid())
  learningPathId String
  teacherId      String
  section        String   // goals | domains | segments | weekly_plan | overall
  sectionLabel   String   // tên hiển thị: "Mục tiêu", "Môn học", "Nội dung bài học", "Kế hoạch tuần", "Tổng thể"
  status         String   @default("pending")
  // pending | approved | needs_revision | rejected

  teacherNotes   String?  // ghi chú của GV
  modifications  Json?    // chỉnh sửa của GV (nếu có)
  originalData   Json?    // dữ liệu gốc trước khi sửa
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  teacher        User         @relation("TeacherApprovals", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([learningPathId])
  @@index([teacherId])
  @@index([status])
  @@unique([learningPathId, section]) // mỗi section chỉ 1 approval record
}

// Learning path mẫu có sẵn (template) - không cần duyệt khi HS chọn
model LearningPathTemplate {
  id               String   @id @default(cuid())
  title            String
  description      String?
  imageUrl         String?
  createdById      String   // giáo viên/admin tạo

  // Nội dung template
  goals            Json     @default("[]")
  domains          Json     @default("[]")  // SubjectDomain[]
  segments         Json     @default("[]")
  weeklyPlan       Json     @default("[]")
  metadata         Json     @default("{}")

  // Matching criteria - dùng để auto-match với khảo sát
  targetAcademicLevels Json @default("[]")  // AcademicLevel[]
  targetGoalTypes      Json @default("[]")  // GoalType[]
  targetDomains        Json @default("[]")  // SubjectDomain[] - môn phù hợp
  difficultyLevel      String @default("balanced") // easy_start | balanced | challenging
  estimatedWeeks       Int    @default(4)
  weeklyHoursRequired  String @default("moderate") // light | moderate | intensive | fulltime

  // Status & stats
  isPublished      Boolean  @default(false)
  rating           Float    @default(0)
  enrollmentCount  Int      @default(0)
  completionRate   Float    @default(0)

  category         String?  // phân loại: "STEM", "Thi đại học", "Kỹ năng mềm"...
  tags             Json     @default("[]")  // string[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy        User           @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)
  learningPaths    LearningPath[] // các LP clone từ template này

  @@index([isPublished])
  @@index([createdById])
