generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

generator seed {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model AIGeneratedContent {
  id                String   @id
  userId            String
  type              String
  title             String
  content           String
  subject           String
  grade             String
  topic             String
  curriculum        String?
  difficulty        String   @default("medium")
  estimatedDuration Int      @default(45)
  status            String   @default("draft")
  usageCount        Int      @default(0)
  rating            Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([createdAt])
  @@index([grade])
  @@index([status])
  @@index([subject])
  @@index([type])
  @@index([userId])
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Attachment {
  id        String   @id
  name      String
  url       String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Category {
  id     String   @id
  name   String   @unique
  Course Course[]
}

model Chapter {
  id           String         @id
  title        String
  description  String?
  videoUrl     String?
  position     Int
  isPublished  Boolean        @default(false)
  isFree       Boolean        @default(false)
  courseId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  Course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  MuxData      MuxData?
  UserProgress UserProgress[]

  @@index([courseId])
}

model ChatMessage {
  id                String        @id
  roomId            String
  senderId          String
  content           String
  type              String        @default("text")
  replyToId         String?
  isDeleted         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  ChatMessage       ChatMessage?  @relation("ChatMessageToChatMessage", fields: [replyToId], references: [id])
  other_ChatMessage ChatMessage[] @relation("ChatMessageToChatMessage")
  ChatRoom          ChatRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  User              User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model ChatParticipant {
  id       String    @id
  roomId   String
  userId   String
  role     String    @default("participant")
  isActive Boolean   @default(true)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  ChatRoom ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  User     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model ChatRoom {
  id              String            @id
  name            String
  description     String?
  type            String            @default("1-1")
  status          String            @default("active")
  maxParticipants Int               @default(2)
  schoolId        String?
  createdBy       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  ChatMessage     ChatMessage[]
  ChatParticipant ChatParticipant[]
  DebateTopic     DebateTopic?
}

model Course {
  id          String       @id
  userId      String
  schoolId    String       @default("default-school")
  title       String
  description String?
  imageUrl    String?
  price       Float?
  isPublished Boolean      @default(false)
  categoryId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  Attachment  Attachment[]
  Chapter     Chapter[]
  Category    Category?    @relation(fields: [categoryId], references: [id])
  User        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  Purchase    Purchase[]

  @@index([categoryId])
  @@index([schoolId])
}

model DebateResult {
  id            String      @id
  topicId       String
  participantId String
  totalScore    Float
  averageScore  Float
  voteCount     Int
  rank          Int
  createdAt     DateTime    @default(now())
  DebateTopic   DebateTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model DebateTopic {
  id              String         @id
  title           String
  description     String?
  category        String?
  difficulty      String         @default("medium")
  timeLimit       Int            @default(300)
  maxParticipants Int            @default(2)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  DebateResult    DebateResult[]
  ChatRoom        ChatRoom       @relation(fields: [id], references: [id])
  DebateVote      DebateVote[]
}

model DebateVote {
  id            String      @id
  topicId       String
  voterId       String
  participantId String
  score         Int
  comment       String?
  createdAt     DateTime    @default(now())
  DebateTopic   DebateTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  User          User        @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([topicId, voterId, participantId])
}

model MuxData {
  id         String  @id
  assetId    String
  playbackId String?
  chapterId  String  @unique
  Chapter    Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model Purchase {
  id        String   @id
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model ResetToken {
  id        String   @id
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  @@index([email])
  @@index([token])
}

model STEMDeliverable {
  id            String        @id
  title         String
  description   String?
  type          String
  url           String?
  milestoneId   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  STEMMilestone STEMMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model STEMFeedback {
  id          String      @id
  author      String
  content     String
  type        String
  isResolved  Boolean     @default(false)
  projectId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  STEMProject STEMProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model STEMMilestone {
  id              String            @id
  title           String
  description     String?
  status          String
  dueDate         DateTime?
  completedAt     DateTime?
  projectId       String
  position        Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  STEMDeliverable STEMDeliverable[]
  STEMProject     STEMProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model STEMProject {
  id             String           @id
  title          String
  description    String?
  category       String
  status         String
  difficulty     String
  progress       Int              @default(0)
  isPublic       Boolean          @default(false)
  thumbnail      String?
  dueDate        DateTime?
  userId         String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  STEMFeedback   STEMFeedback[]
  STEMMilestone  STEMMilestone[]
  User           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  STEMTeamMember STEMTeamMember[]

  @@index([category])
  @@index([status])
  @@index([userId])
}

model STEMTeamMember {
  id          String      @id
  name        String
  role        String
  email       String
  avatar      String?
  projectId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  STEMProject STEMProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StripeCustomer {
  id               String   @id
  userId           String   @unique
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime
}

model User {
  id                    String            @id @default(cuid())
  name                  String?
  email                 String            @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  role                  String            @default("STUDENT")
  schoolId              String            @default("default-school")
  xp                    Int               @default(0)
  
  // Student Information
  idNumber              String?           // Mã định danh Bộ
  dateOfBirth           DateTime?         // Ngày sinh
  gender                String?           // Giới tính (Nam/Nữ)
  
  // Account Security
  failedLoginAttempts   Int               @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  
  // Two-Factor Authentication
  twoFactorEnabled      Boolean           @default(false)
  twoFactorSecret       String?
  twoFactorBackupCodes  String[]          @default([])
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  Account               Account[]
  ChatMessage           ChatMessage[]
  ChatParticipant       ChatParticipant[]
  Course                Course[]
  DebateVote            DebateVote[]
  STEMProject           STEMProject[]
  Session               Session[]
  AuthLog               AuthLog[]
  LabCompletion         LabCompletion[]
  DocumentFolder        DocumentFolder[]
  Document              Document[]
  ExamMatrix            ExamMatrix[]
  Classes               Class[]           @relation("ClassTeacher")
  ClassStudents         ClassStudent[]   @relation("ClassStudent")

  @@index([schoolId])
  @@index([email])
}

model UserProgress {
  id          String   @id
  userId      String
  chapterId   String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([chapterId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuthLog {
  id          String   @id
  userId      String?
  email       String
  action      String   // 'login', 'logout', 'register', 'password_reset', 'failed_login', '2fa_enabled', '2fa_verified'
  status      String   // 'success', 'failed', 'blocked'
  ipAddress   String?
  userAgent   String?
  metadata    Json?    // Additional context (e.g., failure reason, device info)
  createdAt   DateTime @default(now())
  User        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
}

model LabCompletion {
  id          String   @id @default(cuid())
  userId      String
  labId       String   // e.g., 'refraction', 'light-propagation', 'light-shadows'
  labName     String
  xpEarned    Int
  parameters  Json?    // Store parameters used in the experiment
  completedAt DateTime @default(now())
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, labId])
  @@index([userId])
  @@index([labId])
  @@index([completedAt])
}

// ===== KHẢO THÍ SYSTEM - DOCUMENT DIGITIZATION MODULE =====

model DocumentFolder {
  id          String     @id @default(cuid())
  name        String
  parentId    String?    // For nested folders
  userId      String     // Owner/creator
  path        String     // Full path like "SGK toán 9/Chương 5/Bài 17"
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  parent      DocumentFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    DocumentFolder[] @relation("FolderHierarchy")
  documents   Document[]
  User        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentId])
  @@index([path])
}

model Document {
  id                String              @id @default(cuid())
  name              String              // Original filename
  displayName       String              // Display name (e.g., "SGK toán 9")
  type              String              // "VĂN BẢN", "THƯ MỤC", "PDF", "IMAGE"
  mimeType          String?             // e.g., "application/pdf", "image/jpeg"
  fileSize          Int?                // Size in bytes
  originalUrl       String              // URL to original file (S3/GCS)
  digitizedUrl      String?             // URL to digitized/processed file
  folderId          String?             // Parent folder
  userId            String              // Owner/creator
  status            String              @default("Hàng đợi") // "Hàng đợi", "Đang xử lý", "Hoàn tất", "Lỗi"
  processingError   String?            // Error message if status is "Lỗi"
  executionTime     Int?                // Processing time in seconds
  ocrText           String?             // Extracted text from OCR
  metadata          Json?               // Additional metadata (pages, dimensions, etc.)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  processedAt       DateTime?           // When processing completed
  
  folder            DocumentFolder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  processingLogs    DocumentProcessingLog[]

  @@index([userId])
  @@index([folderId])
  @@index([status])
  @@index([createdAt])
  @@index([type])
}

model DocumentProcessingLog {
  id          String   @id @default(cuid())
  documentId  String
  stage       String   // "upload", "ocr", "processing", "completed", "error"
  message     String?
  metadata    Json?    // Additional log data
  createdAt   DateTime @default(now())
  Document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([createdAt])
  @@index([stage])
}

// ===== KHẢO THÍ SYSTEM - EXAM MATRIX MODULE =====

model ExamMatrix {
  id              String            @id @default(cuid())
  name            String            // Matrix name (e.g., "metrix.jfif (Imported)")
  grade           String            // "Khối 6", "Khối 9", etc.
  examType        String            // "Kiểm tra 1 tiết", "Kiểm tra giữa kỳ", etc.
  duration        Int               // Duration in minutes (e.g., 45)
  totalScore      Float             // Total score (e.g., 10.0)
  totalQuestions  Int               @default(0) // Calculated total questions
  type            String            @default("Tạo mới") // "Tạo mới", "Số hoá"
  status          String            @default("Hàng đợi") // "Hàng đợi", "Đang xử lý", "Hoàn tất", "Lỗi"
  originalFileUrl  String?           // If digitized from file
  digitizedFileUrl String?          // Processed file URL
  processingError String?           // Error message if status is "Lỗi"
  userId          String            // Creator/Owner
  createdAt       DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  processedAt     DateTime?
  
  topics          MatrixTopic[]
  User            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  processingLogs  MatrixProcessingLog[]

  @@index([userId])
  @@index([status])
  @@index([grade])
  @@index([examType])
  @@index([createdAt])
}

model MatrixTopic {
  id                String            @id @default(cuid())
  matrixId          String
  order             Int               // Ordinal number (TT)
  topic             String            // Topic name (e.g., "Phương trình và hệ hai phương trình bậc nhất hai ẩn")
  content           String?           // Content/Knowledge unit
  percentageScore   Float?            // % Điểm (calculated)
  
  // Question distributions
  distributions     QuestionDistribution[]
  
  ExamMatrix        ExamMatrix        @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@index([matrixId])
  @@index([order])
}

model QuestionDistribution {
  id                String            @id @default(cuid())
  topicId           String
  questionType      String            // "TNKQ_Nhiều_lựa_chọn", "TNKQ_Đúng_Sai", "TNKQ_Trả_lời_ngắn", "Tự_luận"
  cognitiveLevel    String            // "Biết", "Hiểu", "Vận dụng"
  count             Int               @default(0) // Number of questions
  
  MatrixTopic       MatrixTopic       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@unique([topicId, questionType, cognitiveLevel])
}

model MatrixProcessingLog {
  id          String      @id @default(cuid())
  matrixId    String
  stage       String      // "upload", "ocr", "parsing", "processing", "completed", "error"
  message     String?
  metadata    Json?       // Additional log data
  createdAt   DateTime    @default(now())
  ExamMatrix  ExamMatrix  @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@index([matrixId])
  @@index([createdAt])
  @@index([stage])
}

// ===== KHẢO THÍ SYSTEM - CLASS MANAGEMENT MODULE =====

model Class {
  id          String        @id @default(cuid())
  name        String        // Tên lớp (e.g., "Lớp 9A1")
  grade       String        // Khối (e.g., "Khối 9")
  schoolYear  String        // Năm học (e.g., "2025-2026")
  description String?       // Mô tả
  teacherId   String        // Giáo viên chủ nhiệm
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  teacher     User          @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  students    ClassStudent[]

  @@index([teacherId])
  @@index([grade])
  @@index([schoolYear])
  @@index([createdAt])
}

model ClassStudent {
  id              String        @id @default(cuid())
  classId         String
  studentId       String
  studentNumber   Int?          // Số thứ tự trong lớp
  enrollmentDate  DateTime      @default(now())
  status          String        @default("active") // "active", "inactive", "transferred"
  
  // Student metrics/stats
  attendanceRate  Float?        // Tỷ lệ tham gia (%)
  averageScore    Float?        // Điểm trung bình
  totalXP         Int           @default(0)
  completedExams  Int           @default(0)
  passedExams     Int           @default(0)
  
  // Additional metadata
  notes           String?       // Ghi chú của giáo viên
  metadata        Json?         // Thông tin bổ sung
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  class           Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  student         User          @relation("ClassStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
  @@index([status])
}

// ===== KHẢO THÍ SYSTEM - QUESTION BANK MODULE =====

model Question {
  id                String            @id @default(cuid())
  topic             String            // Chủ đề (e.g., "Phương trình bậc nhất")
  subject           String            // Môn học (e.g., "Toán học", "Văn học")
  grade             String            // Khối (e.g., "Khối 9", "Khối 10")
  questionType      String            // "MCQ", "TRUE_FALSE", "SHORT_ANSWER", "ESSAY", "CODE"
  difficulty        String            // "EASY", "MEDIUM", "HARD"
  content           String            @db.Text // Nội dung câu hỏi
  options           String[]          // Các lựa chọn (cho MCQ)
  correctAnswer     String?           // Đáp án đúng (index cho MCQ, giá trị cho khác)
  explanation       String            @db.Text // Giải thích chi tiết
  learningObjectives String[]         // Mục tiêu học tập
  keywords          String[]          // Từ khóa để tìm kiếm
  
  // Quality metrics
  qualityScore      Float?            // Điểm chất lượng (0-100)
  discriminationIndex Float?           // Chỉ số phân biệt (0-1)
  
  // Usage tracking
  usageCount        Int               @default(0) // Số lần sử dụng
  averageScore      Float?            // Điểm trung bình học sinh đạt được
  averageTimeSeconds Int?             // Thời gian trung bình để trả lời (giây)
  
  // Metadata
  aiGenerated       Boolean           @default(false) // Được tạo bởi AI
  aiModel           String?           // Model AI đã sử dụng (e.g., "gpt-4", "gemini-flash")
  humanReviewed     Boolean           @default(false) // Đã được giáo viên duyệt
  reviewedBy        String?           // ID giáo viên đã duyệt
  reviewedAt        DateTime?         // Thời gian duyệt
  status            String            @default("Nháp") // "Nháp", "Chờ duyệt", "Đã duyệt", "Từ chối"
  
  // Relations
  createdBy         String            // ID người tạo (User)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  // Tags for categorization
  tags              String[]          // Tags để phân loại (e.g., ["đại số", "phương trình"])
  
  // Additional metadata
  metadata          Json?             // Thông tin bổ sung
  
  @@index([subject])
  @@index([grade])
  @@index([questionType])
  @@index([difficulty])
  @@index([status])
  @@index([createdBy])
  @@index([humanReviewed])
  @@index([aiGenerated])
  @@index([createdAt])
  @@index([qualityScore])
  @@index([usageCount])
  // Note: Full-text search can be implemented using PostgreSQL's tsvector/tsquery
  // For now, use regular indexes and LIKE queries for search
}
