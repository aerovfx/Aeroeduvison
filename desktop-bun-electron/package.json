{
  "name": "desktop-bun-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desktop Bun + Electron + React app for image-to-3D workflows",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run clean && bun run build:renderer && bun run build:electron",
    "build:renderer": "bunx vite build",
    "build:electron": "bun build electron/main.ts electron/preload.ts --outdir dist-electron --target node",
    "start": "bun run build && electron .",
    "clean": "rm -rf dist dist-electron"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.8",
    "@react-three/fiber": "^9.0.4",
    "better-sqlite3": "^12.4.1",
    "electron-store": "^10.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^35.2.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  }
}
