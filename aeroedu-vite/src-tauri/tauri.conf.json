{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroEdu Vision",
  "version": "1.0.1",
  "identifier": "com.aeroedu.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "VITE_API_URL_NATIVE=http://127.0.0.1:43127/api npm run dev",
    "beforeBuildCommand": "cd .. && ./scripts/prepare-tauri-macos.sh && cd aeroedu-vite && VITE_API_URL_NATIVE=http://127.0.0.1:43127/api npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AeroEdu Vision",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "copyright": "© AeroEdu Vision",
    "shortDescription": "AeroEdu Vision — nền tảng STEM cho trường học",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/aeroedu-node", "binaries/tectonic"],
    "resources": ["resources/backend/*"]
  }
}
