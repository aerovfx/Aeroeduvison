# ============================================================
# AeroEduVision — Vite Environment Variables
# Đổi từ NEXT_PUBLIC_* → VITE_* (Vite convention)
# ============================================================

# API Gateway URL (Rust aero-backend)
# Dev: chỉ cần để trống (proxy trong vite.config.ts sẽ xử lý)
# Prod: URL của Cloud Run service
VITE_API_URL=

# WebSocket URL
VITE_WS_URL=

# App config
VITE_APP_NAME=AeroEduVision
VITE_APP_ENV=development
