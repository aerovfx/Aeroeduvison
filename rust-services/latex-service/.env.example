# ─── Latex Service environment (Axum / Rust) ────────────────
# Copy this file to `.env` and fill in real values.  NEVER commit the real .env.

# Database ­— Neon PostgreSQL (direct connection, không qua pgbouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=15"

# JWT cùng secret với NextAuth — dùng để xác thực request từ frontend
NEXTAUTH_SECRET="same-secret-as-nextjs-frontend"
JWT_EXPIRY_HOURS=24

# Địa chỉ bind
LATEX_SERVICE_ADDR="0.0.0.0:8109"

# Log level: trace | debug | info | warn | error
RUST_LOG=info

# ─── AI exam generator (/api/latex-projects/ai-generate) ────
# Lấy key tại https://console.anthropic.com/settings/keys
# Phải là key có quota Messages API còn lại.
#
# ⚠️  KEY LẮP VÀO ĐÂY SẼ XUẤT HIỆN TRONG PROCESS ENV CỦA CONTAINER — không commit!
# Trên Cloud Run, set bằng `--set-secrets ANTHROPIC_API_KEY=anthropic-api-key:latest`
# (xem AI_SETUP.md trong thư mục này).
ANTHROPIC_API_KEY="sk-ant-api03-REPLACE_ME"

# Model Claude dùng để sinh đề. Khuyên dùng sonnet (nhanh + rẻ) hoặc opus (chất lượng cao).
# Giá trị hợp lệ: claude-sonnet-4-6 | claude-opus-4-6 | claude-haiku-4-5-20251001
ANTHROPIC_MODEL="claude-sonnet-4-6"
