# ============================================
# LOCAL OLLAMA CONFIGURATION FOR NEMOTRON
# ============================================
# Copy this to .env.local and update the values

# Ollama Configuration (Local AI - FREE)
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=nemotron-orchestrator

# Provider Preference
AI_PREFERRED_PROVIDER=ollama

# Optional: Other providers (fallback)
# OPENROUTER_API_KEY=your-openrouter-key
# GROK_API_KEY=your-grok-key

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Install Ollama: https://ollama.ai/
# 2. Start Ollama: ollama serve
# 3. Pull nemotron model: ollama pull nemotron-orchestrator
# 4. Copy this file to .env.local
# 5. Run test: npm run test:nemotron
