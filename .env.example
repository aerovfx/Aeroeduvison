
# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=aeroedu:

# ============================================
# Agent OS (OpenFang-style) Integration
# ============================================
# Base URL for the external Agent OS (OpenFang or clone)
# Dev default: http://127.0.0.1:4200
OPENFANG_BASE_URL=http://127.0.0.1:4200

# Shared secret for internal calls between Aeroedu and the Agent OS
# Used as Authorization: Bearer <token>
OPENFANG_INTERNAL_TOKEN=changeme-internal-token

# Development Mode: Use mock responses when OpenFang service is not running
# Set to 'true' to enable mock mode (no need to run OpenFang service)
OPENFANG_MOCK_MODE=false

# Redis Cloud (optional)
# REDIS_HOST=redis-12345.c123.us-east-1-2.ec2.cloud.redislabs.com
# REDIS_PORT=12345
# REDIS_PASSWORD=your-secure-password
GCS_BUCKET_MEDIA=aeroedu-media-extreme-lattice-491123-p2

# ============================================
# Anthropic Claude (AI Tutor / inphysic.com/ai-tutor)
# ============================================
# Claude API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
# Default model used by /api/ai-tutor/chat
# Options: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-opus-4-6