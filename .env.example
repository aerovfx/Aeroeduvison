
# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=aeroedu:

# ============================================
# Agent OS (OpenFang-style) Integration
# ============================================
# Base URL for the external Agent OS (OpenFang or clone)
# Dev default: http://127.0.0.1:4200
OPENFANG_BASE_URL=http://127.0.0.1:4200

# Shared secret for internal calls between Aeroedu and the Agent OS
# Used as Authorization: Bearer <token>
OPENFANG_INTERNAL_TOKEN=changeme-internal-token

# Development Mode: Use mock responses when OpenFang service is not running
# Set to 'true' to enable mock mode (no need to run OpenFang service)
OPENFANG_MOCK_MODE=false

# Redis Cloud (optional)
# REDIS_HOST=redis-12345.c123.us-east-1-2.ec2.cloud.redislabs.com
# REDIS_PORT=12345
# REDIS_PASSWORD=your-secure-password

# LaTeX Compile Service (optional, Overleaf-style Rust service)
# When set, /api/latex-projects/compile* will POST to {URL}/compile/sync
# instead of running xelatex/tectonic locally on the Node.js host.
# See latex-compiler/README.md to run the service.
# LATEX_SERVICE_URL=http://localhost:8080

# ============================================================
# Strangler pattern flags: route specific Next.js API endpoints
# to Rust microservices instead of running them in Node.
# When the flag is "true", the Node route proxies to the Rust
# service URL. You can also override per-request via
# `?target=rust` or `x-strangler-target: rust` header.
# See: docs/STRANGLER_PATTERN_RUST.md
# ============================================================

# Default URLs (override if Rust services run on different hosts/ports)
# RUST_BACKEND_URL=http://127.0.0.1:8090       # aero-backend (handles OCR, LLM, vector)
# RUST_VECTOR_SERVICE_URL=http://127.0.0.1:8090 # deprecated alias of RUST_BACKEND_URL
                                                # (vector-sim-service merged into aero-backend)

# Per-route opt-in flags (all default false; service must be running)
# USE_RUST_VECTOR_SERVICE=false                 # /api/vector-similarity
# USE_RUST_OCR_GRADING_SERVICE=false            # /api/ocr-grading
# USE_RUST_OCR_PROCESS_SERVICE=false            # /api/ocr-process
# USE_RUST_OCR_AUTO_GRADE_SERVICE=false         # /api/ocr/auto-grade
# USE_RUST_OCR_UPLOAD_SERVICE=false             # /api/ocr/upload
# USE_RUST_LLM_GRADING_SERVICE=false            # /api/llm-grading
# USE_RUST_ASSIGNMENTS_GRADE_OCR_SERVICE=false  # /api/assignments/grade-ocr
