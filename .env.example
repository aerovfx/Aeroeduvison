
# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=aeroedu:

# ============================================
# Agent OS (OpenFang-style) Integration
# ============================================
# Base URL for the external Agent OS (OpenFang or clone)
# Dev default: http://127.0.0.1:4200
OPENFANG_BASE_URL=http://127.0.0.1:4200

# Shared secret for internal calls between Aeroedu and the Agent OS
# Used as Authorization: Bearer <token>
OPENFANG_INTERNAL_TOKEN=changeme-internal-token

# Development Mode: Use mock responses when OpenFang service is not running
# Set to 'true' to enable mock mode (no need to run OpenFang service)
OPENFANG_MOCK_MODE=false

# Redis Cloud (optional)
# REDIS_HOST=redis-12345.c123.us-east-1-2.ec2.cloud.redislabs.com
# REDIS_PORT=12345
# REDIS_PASSWORD=your-secure-password
GCS_BUCKET_MEDIA=aeroedu-media-extreme-lattice-491123-p2

# ============================================
# Anthropic Claude (AI Tutor / inphysic.com/ai-tutor)
# ============================================
# Claude API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
# Default model used by /api/ai-tutor/chat
# Options: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-opus-4-6
# ============================================
# Payment + Email + Telegram (Bank transfer flow)
# ============================================

# Bank account nhận tiền (hiển thị cho user qua VietQR)
PAYMENT_BANK_NAME=VCB                       # mã bank chuẩn VietQR (VCB, TCB, MB, ACB, BIDV, ...)
PAYMENT_BANK_NAME_FULL=Vietcombank          # tên đầy đủ để hiển thị
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_HOLDER=                     # tên không dấu, viết HOA

# Telegram bot (admin nhận thông báo + duyệt order)
TELEGRAM_BOT_TOKEN=                         # định dạng "123:ABC..."
ADMIN_TELEGRAM_CHAT_ID=                     # optional — auto-bind khi admin /start bot
# TELEGRAM_USE_WEBHOOK=true                 # bật khi prod có public HTTPS URL
# TELEGRAM_WEBHOOK_SECRET=                  # token verify webhook header

# ─── Email gửi mã kích hoạt ───
# Cách 1 (khuyến nghị cá nhân): Gmail SMTP với App Password
#   1. Bật 2FA cho Google account
#   2. Tạo App Password tại https://myaccount.google.com/apppasswords
#      → chọn "Mail", đặt tên "AeroEdu" → copy 16-char (xoá space)
#   3. Điền vào đây:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vietchungvn@gmail.com
SMTP_PASS=                                  # App password 16 ký tự (KHÔNG phải mật khẩu Gmail)
PAYMENT_FROM_EMAIL="AeroEdu <vietchungvn@gmail.com>"

# Cách 2 (alternative): Resend (cần verify domain)
# RESEND_API_KEY=

PUBLIC_URL=http://localhost:5173            # base URL của site, dùng cho link kích hoạt trong email
