    "db:studio": "prisma studio",
    "test:question-bank": "tsx scripts/test-question-bank-api.ts",
    "test:content-validation": "tsx scripts/test-content-validation-api.ts",
    "test:auth-service": "cd rust-services/auth-service && cargo test",
    "rust:backend": "cd rust-services/aero-backend && cargo run",
    "rust:auth": "cargo run --manifest-path rust-services/auth-service/Cargo.toml",
    "rust:all": "bash start-rust.sh",
    "docker:build": "docker build -t lmsmath .",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f",
    "postinstall": "prisma generate",
    "prepare": "husky install || true",
    "dev:all": "bash -c 'bash start-rust.sh & npm run dev --prefix aeroedu-vite'",
    "dev:vite": "npm run dev --prefix aeroedu-vite",
    "dev:rust": "bash start-rust.sh"
