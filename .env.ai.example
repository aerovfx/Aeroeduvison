# ============================================
# AI SERVICE CONFIGURATION
# ============================================

# -----------------
# AI PROVIDERS
# -----------------

# OpenAI Configuration
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_DEFAULT_MODEL="gpt-4-turbo-preview"
OPENAI_ORG_ID="" # Optional

# Google Gemini Configuration
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_DEFAULT_MODEL="gemini-pro"

# Ollama (Local LLM) Configuration
# Ollama provides FREE local AI inference - recommended for cost savings
# Install from: https://ollama.ai/
# Popular models: nemotron-orchestrator, llama3.2, mistral, qwen2.5, deepseek-r1
OPENAI_BASE_URL="http://localhost:11434/v1"
OPENAI_MODEL="nemotron-orchestrator"
# Note: Set OPENAI_API_KEY="ollama" when using Ollama

# Provider Selection
# Options: auto | openai | gemini | ollama
# auto = automatically select best available provider (prioritizes Ollama for cost savings)
AI_PREFERRED_PROVIDER="auto"
AI_FALLBACK_ENABLED="true"

# -----------------
# CACHING
# -----------------

# Cache Configuration
AI_CACHE_ENABLED="true"
AI_CACHE_TTL="604800" # 7 days in seconds
AI_CACHE_KEY_PREFIX="ai:cache"

# Target: 70% cache hit rate
# This can save ~$2,000/month at scale

# -----------------
# RATE LIMITING
# -----------------

# Rate Limit Configuration (per user)
AI_RATE_LIMIT_MINUTE="60"
AI_RATE_LIMIT_HOUR="1000"
AI_RATE_LIMIT_DAY="10000"

# Cost Limits (in USD)
AI_MAX_COST_PER_DAY="100"
AI_DAILY_BUDGET="50"
AI_MONTHLY_BUDGET="1000"

# -----------------
# COST OPTIMIZATION
# -----------------

# Cost Tracking
AI_COST_TRACKING_ENABLED="true"
AI_COST_RETENTION_DAYS="90"

# Alert Thresholds (percentage of budget)
AI_ALERT_THRESHOLD_WARNING="80"
AI_ALERT_THRESHOLD_CRITICAL="100"

# Alert Channels
AI_ALERT_EMAIL="" # Optional: email for cost alerts
AI_ALERT_SLACK_WEBHOOK="" # Optional: Slack webhook URL

# -----------------
# PERFORMANCE
# -----------------

# Request Timeout (milliseconds)
AI_REQUEST_TIMEOUT="30000"

# Retry Configuration
AI_MAX_RETRIES="3"
AI_RETRY_DELAY="1000"

# Batch Processing
AI_BATCH_SIZE="5"
AI_BATCH_DELAY="100"

# -----------------
# MONITORING
# -----------------

# Logging Level
AI_LOG_LEVEL="info" # debug | info | warn | error

# Metrics Export
AI_METRICS_ENABLED="true"
AI_METRICS_INTERVAL="60000" # 1 minute

# Distributed Tracing
AI_TRACING_ENABLED="true"
AI_TRACING_SAMPLE_RATE="0.1" # 10% sampling

# -----------------
# FEATURE FLAGS
# -----------------

# Content Generation
AI_CONTENT_GENERATION_ENABLED="true"
AI_MAX_CONTENT_LENGTH="10000"

# Smart Grading
AI_SMART_GRADING_ENABLED="true"
AI_GRADING_CONFIDENCE_THRESHOLD="0.8"
AI_PARTIAL_CREDIT_ENABLED="true"

# Learning Path Generation
AI_LEARNING_PATH_ENABLED="true"

# Question Generation
AI_QUESTION_GENERATION_ENABLED="true"

# -----------------
# QUALITY CONTROL
# -----------------

# Content Quality
AI_MIN_QUALITY_SCORE="0.7"
AI_ENABLE_CONTENT_FILTERING="true"

# Response Validation
AI_VALIDATE_JSON_RESPONSES="true"
AI_STRICT_MODE="false"

# -----------------
# DEVELOPMENT
# -----------------

# Development Mode
NODE_ENV="development" # development | production
AI_DEBUG_MODE="false"
AI_MOCK_RESPONSES="false"

# -----------------
# REDIS (Required for caching and rate limiting)
# -----------------

REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_TLS="false"

# -----------------
# NOTES
# -----------------

# 1. Get OpenAI API key from: https://platform.openai.com/api-keys
# 2. Get Gemini API key from: https://ai.google.dev/
# 3. Redis is required for production use
# 4. Set AI_PREFERRED_PROVIDER to "auto" for automatic failover
# 5. Monitor costs regularly via the cost tracking dashboard
# 6. Adjust rate limits based on your usage patterns
# 7. Enable caching to reduce costs by up to 70%
# 8. Set appropriate budgets to prevent unexpected costs
