# Performance Optimization Environment Configuration
# Copy this file to .env.local and adjust values as needed

# ============================================
# REDIS CONFIGURATION (Recommended for caching)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# CACHE CONFIGURATION
# ============================================
# L1 (In-Memory) Cache
CACHE_L1_MAX_SIZE=5000
CACHE_L1_TTL=60000

# L2 (Redis) Cache TTL (in seconds)
CACHE_L2_DEFAULT_TTL=300
CACHE_L2_LONG_TTL=3600
CACHE_L2_SHORT_TTL=60

# ============================================
# DATABASE OPTIMIZATION
# ============================================
# Query timeout in milliseconds
QUERY_TIMEOUT=10000

# Slow query threshold in milliseconds
SLOW_QUERY_THRESHOLD=1000

# Connection pool settings
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT=30000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# RUST SERVICES (Canary Proxy)
# ============================================
# Vector Service
RUST_VECTOR_SERVICE_URL=http://127.0.0.1:8091
DIRECT_RUST_VECTOR_PROXY=true

# Backend Service (OCR, Grading)
RUST_BACKEND_URL=http://127.0.0.1:8090
DIRECT_RUST_OCR_GRADING_PROXY=true
DIRECT_RUST_OCR_PROCESS_PROXY=true
DIRECT_RUST_LLM_GRADING_PROXY=true

# Auth Service
RUST_AUTH_URL=http://127.0.0.1:8092
DIRECT_RUST_AUTH_PROXY=false

# Course Service
RUST_COURSE_URL=http://127.0.0.1:8093
DIRECT_RUST_COURSE_PROXY=false

# Admin Service
RUST_ADMIN_URL=http://127.0.0.1:8094
DIRECT_RUST_ADMIN_PROXY=false

# AI Service
RUST_AI_URL=http://127.0.0.1:8095
DIRECT_RUST_AI_PROXY=false

# Student Service
RUST_STUDENT_URL=http://127.0.0.1:8096
DIRECT_RUST_STUDENT_PROXY=false

# STEM Service
RUST_STEM_URL=http://127.0.0.1:8097
DIRECT_RUST_STEM_PROXY=false

# Media Service
RUST_MEDIA_URL=http://127.0.0.1:8098
DIRECT_RUST_MEDIA_PROXY=false

# Camera Service
RUST_CAMERA_URL=http://127.0.0.1:8099
DIRECT_RUST_CAMERA_PROXY=false

# ============================================
# CANARY PROXY CONFIGURATION
# ============================================
# Enable canary proxy for gradual rollout
ENABLE_RUST_CANARY_PROXY=true

# Canary percentage (0-100)
RUST_CANARY_PERCENT=10

# Canary steps for automatic rollout
RUST_CANARY_STEPS=10,25,50,100

# Auto-rollout settings
ENABLE_RUST_CANARY_AUTO_ROLLOUT=true
RUST_CANARY_MIN_REQUESTS_PER_STEP=200
RUST_CANARY_MIN_STEP_MINUTES=10
RUST_CANARY_HEALTHCHECK_INTERVAL_MS=5000

# Disable Rust when unhealthy
RUST_DISABLE_ON_UNHEALTHY=true

# Grading Service canary config
ENABLE_RUST_CANARY_GRADING_PROXY=true
RUST_CANARY_GRADING_PERCENT=10
RUST_CANARY_GRADING_STEPS=10,25,50,100
ENABLE_RUST_CANARY_GRADING_AUTO_ROLLOUT=true
RUST_CANARY_GRADING_MIN_REQUESTS_PER_STEP=200
RUST_CANARY_GRADING_MIN_STEP_MINUTES=10
RUST_CANARY_GRADING_HEALTHCHECK_INTERVAL_MS=5000
RUST_DISABLE_GRADING_ON_UNHEALTHY=true

# LLM Grading specific canary config
ENABLE_RUST_CANARY_LLM_GRADING_PROXY=true
RUST_CANARY_LLM_GRADING_PERCENT=10
RUST_CANARY_LLM_GRADING_STEPS=10,25,50,100
ENABLE_RUST_CANARY_LLM_GRADING_AUTO_ROLLOUT=true
RUST_CANARY_LLM_GRADING_MIN_REQUESTS_PER_STEP=200
RUST_CANARY_LLM_GRADING_MIN_STEP_MINUTES=10
RUST_CANARY_LLM_GRADING_HEALTHCHECK_INTERVAL_MS=5000
RUST_DISABLE_LLM_GRADING_ON_UNHEALTHY=true

# Cookie names for canary bucketing
RUST_CANARY_COOKIE_NAME=rust_canary_bucket
RUST_CANARY_LLM_GRADING_COOKIE_NAME=rust_canary_llm_bucket

# ============================================
# NEXT.JS PERFORMANCE SETTINGS
# ============================================
# Enable compression
NEXT_COMPRESS=true

# Image optimization
NEXT_IMAGE_MINIMUM_CACHE_TTL=300

# ============================================
# AI SERVICE CONFIGURATION
# ============================================
# Request timeout for AI services
AI_REQUEST_TIMEOUT=30000

# Retry settings
AI_MAX_RETRIES=3
AI_RETRY_DELAY=1000

# ============================================
# LOGGING
# ============================================
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Performance logging
LOG_PERFORMANCE=true
LOG_SLOW_QUERIES=true

# ============================================
# FEATURE FLAGS
# ============================================
# Enable advanced caching
ENABLE_ADVANCED_CACHING=true

# Enable request deduplication
ENABLE_REQUEST_DEDUP=true

# Enable performance monitoring
ENABLE_PERFORMANCE_MONITORING=true

# Enable query optimization
ENABLE_QUERY_OPTIMIZATION=true
